# AI for reading lists, photos and bills: set ONE of these (Claude is used if both are set).
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Postgres connection string. Vercel's Neon/Supabase integrations set this for you.
# Leave empty locally to use a SQLite file (padosi.db).
DATABASE_URL=
# Shown in the app header and in the WhatsApp quote
STORE_NAME=Padosi Kirana
# Optional: override the models
# GEMINI_MODEL=gemini-3.8-flash
# PADOSI_MODEL=claude-opus-5-5
