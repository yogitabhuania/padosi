# Required for reading lists with Claude (photos need it). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Postgres connection string. Vercel's Neon/Supabase integrations set this for you.
# Leave empty locally to use a SQLite file (padosi.db).
DATABASE_URL=
# Shown in the app header and in the WhatsApp quote
STORE_NAME=Padosi Kirana
# Optional: override the Claude model
# PADOSI_MODEL=claude-opus-5-5
